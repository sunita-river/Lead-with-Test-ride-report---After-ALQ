# Copy to ".env" and fill in (local runs only). Never commit .env.
# On GitHub these are repository secrets instead - see README.md.

# --- Salesforce login (username + password + security token) ---
SF_USERNAME=integration.user@rideriver.com
SF_PASSWORD=
SF_SECURITY_TOKEN=          # Salesforce > Settings > Reset My Security Token (changes when the password changes)
SF_DOMAIN=login             # "login", "test" for a sandbox, or the My Domain: rivermobilityprivatelimited2.my

# --- or a Connected App (no password expiry); needs SF_DOMAIN set to the My Domain ---
# SF_CONSUMER_KEY=
# SF_CONSUMER_SECRET=

# --- Email (Gmail: use an App Password, not the normal password) ---
SMTP_USER=sunita@rideriver.com
SMTP_PASSWORD=
SMTP_PORT=465               # 465 = SSL; use 587 only if 465 is blocked
EMAIL_TO=sunita@rideriver.com,aarsh@rideriver.com,benwin@rideriver.com

# true = build files in output/ only: no email, lead history unchanged
DRY_RUN=false
